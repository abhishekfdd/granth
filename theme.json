{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "sidebar-docs",
			"title": "Docs Sidebar",
			"area": "uncategorized"
		}
	],
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base"
				},
				{
					"slug": "contrast",
					"color": "#171c26",
					"name": "Contrast"
				},
				{
					"slug": "primary",
					"color": "#2d5be3",
					"name": "Primary"
				},
				{
					"slug": "secondary",
					"color": "#59657a",
					"name": "Secondary"
				},
				{
					"slug": "tertiary",
					"color": "#f4f6fa",
					"name": "Tertiary"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.25rem",
					"name": "2X-Small"
				},
				{
					"slug": "30",
					"size": "0.5rem",
					"name": "X-Small"
				},
				{
					"slug": "40",
					"size": "0.75rem",
					"name": "Small"
				},
				{
					"slug": "50",
					"size": "clamp(1rem, 0.85rem + 0.75vw, 1.5rem)",
					"name": "Medium"
				},
				{
					"slug": "60",
					"size": "clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem)",
					"name": "Large"
				},
				{
					"slug": "70",
					"size": "clamp(2.25rem, 1.75rem + 2.5vw, 4rem)",
					"name": "X-Large"
				},
				{
					"slug": "80",
					"size": "clamp(3rem, 2.25rem + 3.75vw, 5.5rem)",
					"name": "2X-Large"
				}
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"typography": {
			"fluid": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "\"Figtree\", ui-sans-serif, system-ui, -apple-system, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Figtree",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree/figtree-variable.woff2" ]
						},
						{
							"fontFamily": "Figtree",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/figtree/figtree-italic-variable.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono/jetbrains-mono-variable.woff2" ]
						},
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "italic",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono/jetbrains-mono-italic-variable.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.9375rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1.0625rem",
					"name": "Medium",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"size": "1.375rem",
					"name": "Large",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.375rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.875rem",
					"name": "Extra Large",
					"fluid": {
						"min": "1.5rem",
						"max": "1.875rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "2.75rem",
					"name": "2X Large",
					"fluid": {
						"min": "2rem",
						"max": "2.75rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|contrast"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "650",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontWeight": "600"
				},
				"border": {
					"radius": "6px"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|contrast",
						"text": "var:preset|color|base"
					}
				}
			},
			"code": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "0.875em"
				},
				"color": {
					"background": "var:preset|color|tertiary"
				}
			}
		},
		"blocks": {
			"core/code": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				},
				"color": {
					"background": "var:preset|color|tertiary",
					"text": "var:preset|color|contrast"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"right": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50"
					}
				},
				"border": {
					"radius": "8px"
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small",
					"lineHeight": "1.6"
				},
				"color": {
					"background": "var:preset|color|tertiary"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|50",
						"right": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50",
						"left": "var:preset|spacing|50"
					}
				},
				"border": {
					"radius": "8px"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|primary",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var:preset|spacing|50"
					}
				},
				"typography": {
					"fontStyle": "normal"
				}
			},
			"core/site-title": {
				"typography": {
					"fontWeight": "700"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|contrast"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			}
		}
	}
}
